@{
    ViewData["Title"] = "Cadastro";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cadastro.css" asp-append-version="true" />
}

<div class="pagina-cadastro">
    <h1 class="cad-titulo">Cadastro</h1>

    <div class="cad-cartao">
        <form method="post">
            <div class="cad-linha">
                <label for="nome">Nome completo:</label>
                <input type="text" id="nome" name="Nome" class="cad-campo" />
            </div>

            <div class="cad-linha">
                <label for="cpf">CPF:</label>
                <input type="text" id="cpf" name="Cpf" inputmode="numeric" maxlength="11" class="cad-campo" />
            </div>

            <div class="cad-linha">
                <label for="telefone">Telefone:</label>
                <input type="tel" id="telefone" name="Telefone" inputmode="numeric" maxlength="11" class="cad-campo" />
            </div>

            <div class="cad-linha">
                <label for="email">E-mail:</label>
                <input type="email" id="email" name="Email" class="cad-campo" />
            </div>

            <div class="cad-linha">
                <label for="senha">Nova senha:</label>
                <input type="password" id="senha" name="Senha" class="cad-campo" />
            </div>

            <div class="cad-linha">
                <label for="confirmacao">Confirmação de Senha:</label>
                <input type="password" id="confirmacao" name="ConfirmacaoSenha" class="cad-campo" />
            </div>

            <button type="submit" class="cad-botao">Cadastrar</button>
        </form>
    </div>
</div>