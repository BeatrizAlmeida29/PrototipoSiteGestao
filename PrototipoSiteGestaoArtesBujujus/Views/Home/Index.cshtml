@{
    ViewData["Title"] = "Início";
}

@section Styles {
    <link rel="stylesheet" href="~/css/welcome.css" asp-append-version="true" />
}

<div class="pagina-welcome">
    <section class="hero">
        <h1 class="hero-titulo">Seu pedido, do jeito que você imaginou!</h1>
        <p class="hero-subtitulo">Escolha, acompanhe cada etapa e receba sem complicação.</p>
        <a href="#" class="hero-botao">Ver catálogo</a>

        <div class="carrossel">
            <button type="button" class="carrossel-seta carrossel-seta-esq" id="seta-anterior" aria-label="Imagem anterior">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="20" y1="12" x2="4" y2="12" />
                    <polyline points="10 6 4 12 10 18" />
                </svg>
            </button>

            <img class="slide ativo" src="~/img/slide1.jpg" alt="Caixa personalizada" />
            <img class="slide" src="~/img/slide2.webp" alt="Produto personalizado 2" />
            <img class="slide" src="~/img/slide3.webp" alt="Produto personalizado 3" />

            <button type="button" class="carrossel-seta carrossel-seta-dir" id="seta-proxima" aria-label="Próxima imagem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="12" x2="20" y2="12" />
                    <polyline points="14 6 20 12 14 18" />
                </svg>
            </button>
        </div>

        <div class="carrossel-pontos">
            <button type="button" class="ponto ativo" aria-label="Imagem 1"></button>
            <button type="button" class="ponto" aria-label="Imagem 2"></button>
            <button type="button" class="ponto" aria-label="Imagem 3"></button>
        </div>
    </section>

    <section class="como-funciona">
        <h2>Como funciona</h2>
        <div class="passos">
            <div class="passo"><span class="passo-numero">1</span><span class="passo-texto">Escolha o produto</span></div>
            <div class="passo"><span class="passo-numero">2</span><span class="passo-texto">Confirmamos com você</span></div>
            <div class="passo"><span class="passo-numero">3</span><span class="passo-texto">Pagamento</span></div>
            <div class="passo"><span class="passo-numero">4</span><span class="passo-texto">Produção e Entrega</span></div>
        </div>
    </section>

    <footer class="rodape">
        <p class="rodape-endereco"><strong>Endereço:</strong> Rua Antonio Sioma, nº 11 - São Paulo/SP</p>
        <a href="#" class="rodape-link">Sobre nós</a>
    </footer>
</div>

@section Scripts {
    <script src="~/js/welcome.js" asp-append-version="true"></script>
}