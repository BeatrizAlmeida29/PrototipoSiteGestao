@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="pagina-login">
    <h1 class="titulo">Entrar</h1>

    @if (TempData["Sucesso"] != null)
    {
        <p class="sucesso">@TempData["Sucesso"]</p>
    }

    @if (ViewBag.Erro != null)
    {
        <p class="erro">@ViewBag.Erro</p>
    }

    <div class="cartao">
        <form method="post">
            <label for="email">Login:</label>
            <input type="email" id="email" name="Email" class="campo" placeholder="ex.: seuemail@email.com" />

            <label for="senha">Senha:</label>
            <input type="password" id="senha" name="Senha" class="campo" placeholder="ex.: suasenha" />

            <a href="#" class="link-esqueci">Esqueci a senha</a>

            <button type="submit" class="botao">Iniciar sessão</button>

            <p class="criar-conta">Não possui uma conta ainda? <a href="/Cadastro">Criar uma conta</a></p>
        </form>
    </div>
</div>